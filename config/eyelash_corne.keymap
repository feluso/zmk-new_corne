/*
 * Eyelash Corne — one-handed (left half) keymap
 *
 * Design notes:
 *  - The left half alone is the keyboard: 18 main keys + 1 extra + 3 thumbs = 22.
 *  - MIRR is a TRUE mirror of the right half (each row reversed), so every key
 *    keeps its finger and row. E<->I are both middle finger, T<->Y both index.
 *  - Mods are sticky (&sk): tap, release, then tap the key. No chording needed
 *    with one hand. Thumb Ctrl is a real hold for the common Ctrl+key case.
 *  - NAV is a conditional layer: hold NUM + SYM (thumb + index) together.
 *  - &mirror: hold = momentary mirror, tap = lock it on (tap again to release).
 *    Layer locking is a ZMK main feature; it means one hand never has to hold
 *    a layer key down while typing.
 */

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define MIRR 1
#define NUM  2
#define SYM  3
#define NAV  4
#define SYS  5

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        // Thumb mod-tap: balanced, so Ctrl wins as soon as another key is
        // pressed and released. tap-preferred would swallow the mod.
        tmod: thumb_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        // Layer-tap, balanced for the same reason.
        ltb: layer_tap_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Both left thumbs together = lock the mirror on (again = release).
        // Deliberately a two-key press: a single thumb can no longer latch
        // the layer by accident, which is what the old tap-to-toggle did.
        mirror_lock {
            bindings = <&tog MIRR>;
            key-positions = <42 43>;
            layers = <BASE MIRR>;
            timeout-ms = <50>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        nav_layer {
            if-layers = <NUM SYM>;
            then-layer = <NAV>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <30>;
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp BSPC       &kp Q  &kp W  &kp E  &kp R  &kp T                                  &kp BSPC                &kp Y  &kp U  &kp I      &kp O    &kp P     &kp ESC
&sk LSHFT      &kp A  &kp S  &kp D  &kp F  &kp G                &kp TAB  &kp ENTER  &kp DEL               &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp ENTER      &kp Z  &kp X  &kp C  &kp V  &kp B   &ltb SYM TAB              &kp ENTER                    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                       &ltb NUM ESC  &mo MIRR            &tmod LCTRL SPACE                          &kp SPACE  &kp BSPC  &kp ENTER
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        mirror_layer {
            display-name = "MIRROR";
            bindings = <
&kp LBKT   &kp P     &kp O    &kp I      &kp U  &kp Y                             &trans              &trans  &trans  &trans  &trans  &trans  &trans
&kp RBKT   &kp SEMI  &kp L    &kp K      &kp J  &kp H              &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans
&kp BSLH   &kp FSLH  &kp DOT  &kp COMMA  &kp M  &kp N     &trans            &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                               &trans  &trans  &trans                                            &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&kp DEL    &kp N1     &kp N2     &kp N3      &kp N4       &kp N5                          &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans     &sk LGUI   &sk LALT   &sk LCTRL   &sk LSHFT    &caps_word     &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp N6     &kp N7     &kp N8      &kp N9       &kp N0    &trans              &trans               &trans  &trans  &trans  &trans  &trans  &trans
                                  &trans  &trans  &trans                                                 &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
&trans     &kp GRAVE  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT                        &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp SEMI   &kp SQT    &kp COMMA  &kp DOT   &kp FSLH       &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp BSLH   &kp LPAR   &kp RPAR   &kp LBRC  &kp RBRC  &trans              &trans               &trans  &trans  &trans  &trans  &trans  &trans
                                  &trans  &trans  &trans                                                 &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&kp PG_UP  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &kp PSCRN                 &trans              &trans  &trans  &trans  &trans  &trans  &trans
&kp PG_DN  &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &kp DEL   &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&kp INS    &mkp LCLK       &mkp MCLK       &mkp RCLK     &kp HOME         &kp END   &trans          &trans              &trans  &trans  &trans  &trans  &trans  &trans
                                  &trans  &tog SYS  &trans                                              &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sys_layer {
            display-name = "SYS";
            bindings = <
&bootloader      &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2   &bt BT_SEL 3     &bt BT_SEL 4                    &trans              &trans  &trans  &trans  &trans  &trans  &trans
&sys_reset       &bt BT_CLR       &out OUT_USB     &out OUT_BLE   &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&studio_unlock   &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &bl BL_TOG     &soft_off        &none      &trans          &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                                  &trans  &tog SYS  &trans                                              &trans  &trans  &trans
            >;
            sensor-bindings = <&rgb_encoder>;
        };
    };
};
